# Copy to .env and fill in from https://developer.spotify.com/dashboard
# Redirect URI must use the loopback IP: Spotify rejects `localhost` since 27 Nov 2025.
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Optional: Spotify embed proxy (see proxy/README.md). Dev uses the Vite proxy automatically.
# VITE_EMBED_PROXY_URL=https://spotify-sort-embed-proxy.example.workers.dev/spotify-embed
